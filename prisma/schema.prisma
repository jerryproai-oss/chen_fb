// ── Prisma Schema for 拾日 (Shiri) ────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// ── Models ────────────────────────────────────────────────

model User {
  id                         String      @id @default(uuid()) @db.Uuid
  username                   String
  usernameNormalized         String      @unique @map("username_normalized")
  displayName                String      @map("display_name")
  avatarUrl                  String?     @map("avatar_url")
  passwordHash               String      @map("password_hash")
  role                       Role        @default(MEMBER)
  status                     UserStatus  @default(ACTIVE)
  mustChangePassword         Boolean     @default(false) @map("must_change_password")
  temporaryPasswordExpiresAt DateTime?   @map("temporary_password_expires_at")
  passwordVersion            Int         @default(1) @map("password_version")
  passwordChangedAt          DateTime?   @map("password_changed_at")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")

  sessions Session[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  passwordVersion   Int       @map("password_version")
  restricted        Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_events")
}
