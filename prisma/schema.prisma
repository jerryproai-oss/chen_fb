// ── Prisma Schema for 拾日 (Shiri) ────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Visibility {
  PRIVATE   // 僅自己
  FAMILY    // 家人可見
  SELECTED  // 指定家人
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum ReactionType {
  LIKE        // 讚
  LOVE        // 愛心
  CARE        // 抱抱
  LAUGH       // 大笑
  WOW         // 驚訝
  SAD         // 難過
  ANGRY       // 生氣
  RECEIVED    // 收到
  NO_PROBLEM  // 沒問題
}

// ── Models ────────────────────────────────────────────────

model User {
  id                         String      @id @default(uuid()) @db.Uuid
  username                   String
  usernameNormalized         String      @unique @map("username_normalized")
  displayName                String      @map("display_name")
  avatarUrl                  String?     @map("avatar_url")
  passwordHash               String      @map("password_hash")
  role                       Role        @default(MEMBER)
  status                     UserStatus  @default(ACTIVE)
  mustChangePassword         Boolean     @default(false) @map("must_change_password")
  temporaryPasswordExpiresAt DateTime?   @map("temporary_password_expires_at")
  passwordVersion            Int         @default(1) @map("password_version")
  passwordChangedAt          DateTime?   @map("password_changed_at")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")

  sessions Session[]
  posts         Post[]
  audiences     PostAudience[]
  comments      Comment[]
  reactions     PostReaction[]
  media         PostMedia[]
  pollVotes     PollVote[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  passwordVersion   Int       @map("password_version")
  restricted        Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_events")
}

// ── Phase 2: 貼文系統 ────────────────────────────────────

model Post {
  id            String      @id @default(uuid()) @db.Uuid
  authorId      String      @map("author_id") @db.Uuid
  recordDate    DateTime    @map("record_date") @db.Date
  title         String
  subtitle      String?
  bodyJson      String?     @map("body_json")       // 結構化內容（未來富文字）
  bodyPlainText String?     @map("body_plain_text")  // 純文字，用於搜尋與預覽
  visibility    Visibility  @default(PRIVATE)
  status        PostStatus  @default(DRAFT)
  version       Int         @default(1)
  publishedAt   DateTime?   @map("published_at")
  deletedAt     DateTime?   @map("deleted_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  audiences PostAudience[]
  comments  Comment[]
  reactions PostReaction[]
  media     PostMedia[]
  poll      Poll?

  @@index([authorId])
  @@index([recordDate])
  @@index([visibility, status])
  @@index([publishedAt])
  @@index([deletedAt])
  @@map("posts")
}

// ── Phase 3: 媒體附件 ────────────────────────────────────

model PostMedia {
  id          String   @id @default(uuid()) @db.Uuid
  postId      String?  @map("post_id") @db.Uuid
  uploaderId  String   @map("uploader_id") @db.Uuid
  filename    String                       // 原始檔名
  storagePath String   @map("storage_path") // 磁碟路徑 (相對 /data/media)
  mimeType    String   @map("mime_type")
  fileSize    Int      @map("file_size")    // bytes
  width       Int?                          // 圖片寬度
  height      Int?                          // 圖片高度
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  post     Post? @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([uploaderId])
  @@map("post_media")
}

model PostAudience {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_audiences")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  bodyText  String    @map("body_text")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model PostReaction {
  postId    String       @map("post_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_reactions")
}

// ── Phase 5: 投票系統 ────────────────────────────────────

model Poll {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String    @unique @map("post_id") @db.Uuid
  question    String                         // 投票主題
  multiSelect Boolean   @default(false) @map("multi_select")
  endsAt      DateTime? @map("ends_at")      // 截止時間（可選）
  createdAt   DateTime  @default(now()) @map("created_at")

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@map("polls")
}

model PollOption {
  id          String  @id @default(uuid()) @db.Uuid
  pollId      String  @map("poll_id") @db.Uuid
  text        String                           // 選項文字（必填）
  description String?                          // 說明（選填）
  imageUrl    String? @map("image_url")        // 圖片 media URL（選填）
  linkUrl     String? @map("link_url")         // 外部連結（選填）
  sortOrder   Int     @default(0) @map("sort_order")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  optionId  String   @map("option_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([userId])
  @@map("poll_votes")
}
