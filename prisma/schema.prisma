// ── Prisma Schema for 拾日 (Shiri) ────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ─────────────────────────────────────────────────

enum Role {
  ADMIN
  MEMBER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Visibility {
  PRIVATE   // 僅自己
  FAMILY    // 家人可見
  SELECTED  // 指定家人
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum ReactionType {
  LIKE        // 讚
  LOVE        // 愛心
  CARE        // 抱抱
  LAUGH       // 大笑
  WOW         // 驚訝
  SAD         // 難過
  ANGRY       // 生氣
  RECEIVED    // 收到
  NO_PROBLEM  // 沒問題
}

// ── 用車管理 Enums ────────────────────────────────────────

enum FamilyRole {
  PARENT
  CHILD
}

enum BookingStatus {
  RESERVED    // 已預約
  OUT         // 已出車
  COMPLETED   // 已完成
  CANCELLED   // 已取消
}

enum RecurringType {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum PaymentMethod {
  CASH          // 現金
  CREDIT_CARD   // 信用卡
  DEBIT_CARD    // 簽帳金融卡
  BANK_TRANSFER // 銀行轉帳
  LINE_PAY      // LINE Pay
  APPLE_PAY     // Apple Pay
  OTHER         // 其他
}

enum CostStatus {
  PENDING     // 待確認
  CONFIRMED   // 已確認
}

enum PaymentStatus {
  UNPAID      // 待繳
  PAID        // 已繳（本人標記）
  CONFIRMED   // 已確認（ADMIN 確認）
}

enum CalcMethod {
  DUAL_TRACK  // 雙軌天數計費制（均分+天數）
  EVEN_SPLIT  // 直接均分制
}

enum EffectiveMode {
  RETROACTIVE // 含設定前（所有結算適用）
  IMMEDIATE   // 即刻生效
  SCHEDULED   // 指定生效日
}

enum FuelType {
  GASOLINE    // 汽油
  DIESEL      // 柴油
  ELECTRIC    // 電動
  OTHER       // 其他
}

enum DocType {
  RECEIPT     // 收據
  WARRANTY    // 保修單
  INSURANCE   // 保險單
  INSPECTION  // 檢驗報告
  LOAN        // 貸款文件
  OTHER       // 其他
}

enum LoanPaymentStatus {
  UPCOMING    // 即將到期
  PAID        // 已繳
  OVERDUE     // 逾期
}

enum MileageSource {
  MANUAL        // 手動更新
  BOOKING_START // 出車記錄
  BOOKING_END   // 還車記錄
  FUEL          // 加油記錄
}

enum CarNotificationType {
  BOOKING_NEW           // 有人預約用車
  BOOKING_CONFLICT      // 預約衝突
  BOOKING_STATUS        // 預約狀態變更
  COST_NEW              // 新增費用結算
  COST_PAYMENT_DUE      // 未繳款提醒
  COST_PAYMENT_CONFIRMED // 繳款已確認
  MAINTENANCE_DUE       // 保養到期提醒
  INSURANCE_EXPIRING    // 保險即將到期
  LOAN_PAYMENT_DUE      // 車貸繳款提醒
  CONFIG_CHANGED        // 規則變更通知
}

// ── Models ────────────────────────────────────────────────

model User {
  id                         String      @id @default(uuid()) @db.Uuid
  username                   String
  usernameNormalized         String      @unique @map("username_normalized")
  displayName                String      @map("display_name")
  avatarUrl                  String?     @map("avatar_url")
  avatarDriveId              String?     @map("avatar_drive_id")
  calendarColor              String?     @map("calendar_color")
  birthday                   DateTime?   @map("birthday") @db.Date
  passwordHash               String      @map("password_hash")
  role                       Role        @default(MEMBER)
  status                     UserStatus  @default(ACTIVE)
  mustChangePassword         Boolean     @default(false) @map("must_change_password")
  temporaryPasswordExpiresAt DateTime?   @map("temporary_password_expires_at")
  passwordVersion            Int         @default(1) @map("password_version")
  passwordChangedAt          DateTime?   @map("password_changed_at")
  lastLoginAt                DateTime?   @map("last_login_at")
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")

  sessions      Session[]
  posts         Post[]
  audiences     PostAudience[]
  comments      Comment[]
  reactions     PostReaction[]
  media         PostMedia[]
  pollVotes     PollVote[]
  bookmarks     PostBookmark[]
  notifications Notification[]   @relation("notifications")
  notifyActs    Notification[]   @relation("notificationActor")
  albums        Album[]
  familyEvents  FamilyEvent[]
  stories       Story[]
  vaultPin      VaultPin?
  vaultItems    VaultItem[]
  vaultOwnedShares  VaultMember[] @relation("vaultOwner")
  vaultMemberShares VaultMember[] @relation("vaultMember")
  healthRecords         HealthRecord[]
  healthSharesAsOwner   HealthSharePermission[] @relation("healthOwner")
  healthSharesAsViewer  HealthSharePermission[] @relation("healthViewer")
  wikiPages             WikiPage[]
  wikiEdits             WikiPageVersion[]
  wikiPermissions       WikiPagePermission[]
  contacts              Contact[]
  notes                 Note[]
  noteAudiences         NoteAudience[]
  quickShares           QuickShare[]
  shareCategories       ShareCategory[]

  // ── 用車管理 ────────────────────
  familyRole            FamilyRole?   @map("family_role")
  familyTitle           String?       @map("family_title")              // 輩分（爸爸、媽媽、大兒子…）
  notifyEmails          Json?         @map("notify_emails")           // 通知信箱陣列
  emailNotifyEnabled    Boolean       @default(false) @map("email_notify_enabled")

  carBookings           CarBooking[]
  carCostRecordsPaid    CarCostRecord[]    @relation("costPaidBy")
  carCostRecordsCreated CarCostRecord[]    @relation("costCreatedBy")
  carCostShares         CarCostShare[]
  carCostSharesConfirmed CarCostShare[]    @relation("shareConfirmedBy")
  carCostAttachments    CarCostAttachment[]
  carCostConfigs        CarCostConfig[]
  carFuelRecords        CarFuelRecord[]
  carCostAmendments     CarCostAmendment[]
  carNotifications      CarNotification[]
  carMileageLogs        CarMileageLog[]

  // ── 看板管理 ────────────────────
  kanbanBoards        KanbanBoard[]
  kanbanCardsAssigned KanbanCard[]  @relation("kanbanAssignee")
  kanbanCardsCreated  KanbanCard[]  @relation("kanbanCreatedBy")

  // ── 個人記帳 ────────────────────
  expenseCategories ExpenseCategory[]
  expenseRecords    ExpenseRecord[]
  expenseBudgets    ExpenseBudget[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  issuedAt          DateTime  @default(now()) @map("issued_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  absoluteExpiresAt DateTime  @map("absolute_expires_at")
  revokedAt         DateTime? @map("revoked_at")
  passwordVersion   Int       @map("password_version")
  restricted        Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorId      String?  @map("actor_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  outcome      String
  requestId    String?  @map("request_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
  @@map("audit_events")
}

// ── Phase 2: 貼文系統 ────────────────────────────────────

model Post {
  id            String      @id @default(uuid()) @db.Uuid
  authorId      String      @map("author_id") @db.Uuid
  recordDate    DateTime    @map("record_date") @db.Date
  title         String
  subtitle      String?
  bodyJson      String?     @map("body_json")       // 結構化內容（未來富文字）
  bodyPlainText String?     @map("body_plain_text")  // 純文字，用於搜尋與預覽
  visibility    Visibility  @default(PRIVATE)
  status        PostStatus  @default(DRAFT)
  version       Int         @default(1)
  publishedAt   DateTime?   @map("published_at")
  deletedAt     DateTime?   @map("deleted_at")
  pinnedAt      DateTime?   @map("pinned_at")        // 釘選時間
  locationName  String?     @map("location_name")    // 地點名稱
  bgColor       String?     @map("bg_color")         // 貼文背景色
  isMilestone   Boolean     @default(false) @map("is_milestone")  // 人生大事
  milestoneType String?     @map("milestone_type")   // 里程碑類型
  quotedPostId  String?     @map("quoted_post_id") @db.Uuid  // 引用貼文
  threadId      String?     @map("thread_id") @db.Uuid  // 串文群組 ID
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  audiences PostAudience[]
  comments  Comment[]
  reactions PostReaction[]
  media     PostMedia[]
  poll      Poll?
  bookmarks PostBookmark[]
  tags      PostTag[]

  @@index([authorId])
  @@index([recordDate])
  @@index([visibility, status])
  @@index([publishedAt])
  @@index([deletedAt])
  @@index([pinnedAt])
  @@index([threadId])
  @@map("posts")
}

// ── Phase 3: 媒體附件 ────────────────────────────────────

model PostMedia {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String?   @map("post_id") @db.Uuid
  uploaderId  String    @map("uploader_id") @db.Uuid
  filename    String                       // 原始檔名
  storagePath String    @map("storage_path") // 磁碟路徑 (相對 /data/media)
  mimeType    String    @map("mime_type")
  fileSize    Int       @map("file_size")    // bytes
  width       Int?                          // 圖片寬度
  height      Int?                          // 圖片高度
  caption     String?                       // 心情文/說明文字
  takenAt     DateTime? @map("taken_at")    // EXIF 拍攝時間
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  post       Post?       @relation(fields: [postId], references: [id], onDelete: Cascade)
  uploader   User        @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  albumItems AlbumItem[]

  @@index([postId])
  @@index([uploaderId])
  @@map("post_media")
}

model PostAudience {
  postId String @map("post_id") @db.Uuid
  userId String @map("user_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_audiences")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @map("post_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  bodyText  String    @map("body_text")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@map("comments")
}

model PostReaction {
  postId    String       @map("post_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@map("post_reactions")
}

// ── Phase 5: 投票系統 ────────────────────────────────────

model Poll {
  id          String    @id @default(uuid()) @db.Uuid
  postId      String    @unique @map("post_id") @db.Uuid
  question    String                         // 投票主題
  multiSelect Boolean   @default(false) @map("multi_select")
  endsAt      DateTime? @map("ends_at")      // 截止時間（可選）
  closedAt    DateTime? @map("closed_at")    // 手動關閉時間
  createdAt   DateTime  @default(now()) @map("created_at")

  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  options PollOption[]

  @@map("polls")
}

model PollOption {
  id          String  @id @default(uuid()) @db.Uuid
  pollId      String  @map("poll_id") @db.Uuid
  text        String                           // 選項文字（必填）
  description String?                          // 說明（選填）
  imageUrl    String? @map("image_url")        // 圖片 media URL（選填）
  linkUrl     String? @map("link_url")         // 外部連結（選填）
  sortOrder   Int     @default(0) @map("sort_order")

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
  @@map("poll_options")
}

model PollVote {
  optionId  String   @map("option_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([optionId, userId])
  @@index([userId])
  @@map("poll_votes")
}

// ── Phase 6: 收藏 ─────────────────────────────────────────

model PostBookmark {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_bookmarks")
}

// ── Phase 6: 標籤系統 ─────────────────────────────────────

model Tag {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique              // 顯示用名稱（不含 #）
  slug String @unique              // URL-safe slug

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

// ── Phase 6: 通知系統 ─────────────────────────────────────

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid         // 收件人
  type       String                                      // COMMENT, REACTION, MENTION, BIRTHDAY, etc.
  title      String                                      // 通知標題
  body       String?                                     // 通知內文
  linkUrl    String?  @map("link_url")                   // 點擊後前往的 URL
  isRead     Boolean  @default(false) @map("is_read")
  actorId    String?  @map("actor_id") @db.Uuid          // 觸發者
  resourceId String?  @map("resource_id")                // 相關資源 ID
  createdAt  DateTime @default(now()) @map("created_at")

  user  User  @relation("notifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("notificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ── Phase 6: 相簿 ─────────────────────────────────────────

model Album {
  id           String   @id @default(uuid()) @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  title        String
  description  String?
  coverMediaId String?  @map("cover_media_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  author User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  items  AlbumItem[]

  @@index([authorId])
  @@map("albums")
}

model AlbumItem {
  albumId   String   @map("album_id") @db.Uuid
  mediaId   String   @map("media_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order")
  addedAt   DateTime @default(now()) @map("added_at")

  album Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media PostMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
  @@map("album_items")
}

// ── Phase 6: 家庭行事曆 ───────────────────────────────────

model FamilyEvent {
  id              String    @id @default(uuid()) @db.Uuid
  authorId        String    @map("author_id") @db.Uuid
  title           String
  description     String?
  eventDate       DateTime  @map("event_date") @db.Date    // 開始日期
  endDate         DateTime? @map("end_date") @db.Date      // 結束日期（跨天事件）
  eventTime       String?   @map("event_time")             // 開始時間 (HH:mm)
  endTime         String?   @map("end_time")               // 結束時間 (HH:mm)
  isAllDay        Boolean   @default(true) @map("is_all_day")
  color           String?   @default("#5a7a5a")            // 事件顏色
  location        String?                                   // 地點
  isRecurring     Boolean   @default(false) @map("is_recurring")
  recurringType   String?   @map("recurring_type")         // YEARLY, MONTHLY, WEEKLY, DAILY
  recurringEndDate DateTime? @map("recurring_end_date") @db.Date  // 循環結束日期
  needsCar        Boolean   @default(false) @map("needs_car")      // 🚗 需要用車
  carStartTime    String?   @map("car_start_time")                 // 用車開始時間 (HH:mm)
  carEndTime      String?   @map("car_end_time")                   // 用車結束時間 (HH:mm)
  isImportant     Boolean   @default(false) @map("is_important")   // ⭐ 重要行程
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([eventDate])
  @@map("family_events")
}

// ── Phase 6: 限時動態 ─────────────────────────────────────

model Story {
  id        String    @id @default(uuid()) @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  mediaId   String?   @map("media_id") @db.Uuid         // 媒體 ID
  text      String?                                       // 文字內容
  bgColor   String?   @map("bg_color")                   // 背景色
  expiresAt DateTime  @map("expires_at")                  // 過期時間 (24h)
  createdAt DateTime  @default(now()) @map("created_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([expiresAt])
  @@map("stories")
}

// ── Phase 8: 特別區 (Vault) ────────────────────────────────

model VaultPin {
  userId    String   @id @map("user_id") @db.Uuid
  pinHash   String   @map("pin_hash")
  salt      String                              // PBKDF2 salt for key derivation
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("vault_pins")
}

model VaultItem {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdBy    String?  @map("created_by") @db.Uuid
  titleEnc     String   @map("title_enc")
  contentEnc   String   @map("content_enc")
  category     String   @default("NOTE")
  iv           String
  pinnedAt     DateTime? @map("pinned_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments VaultAttachment[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, pinnedAt(sort: Desc)])
  @@map("vault_items")
}

model VaultAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  filename  String
  mimeType  String   @map("mime_type")
  fileSize  Int      @map("file_size")
  pathEnc   String   @map("path_enc")
  iv        String
  createdAt DateTime @default(now()) @map("created_at")

  item VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@map("vault_attachments")
}

model VaultMember {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  owner  User @relation("vaultOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member User @relation("vaultMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ownerId, memberId])
  @@map("vault_members")
}

// ── Health Tracking ──────────────────────────────────────────

model HealthRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  recordedAt     DateTime @map("recorded_at")

  systolic       Int?     // 收縮壓 (mmHg)
  diastolic      Int?     // 舒張壓 (mmHg)
  heartRate      Int?     @map("heart_rate")          // 心率 (bpm)
  bloodSugar     Float?   @map("blood_sugar")         // 血糖 (mg/dL)
  mealTiming     String?  @map("meal_timing")         // fasting / before / after
  temperature    Float?                               // 體溫 (°C)
  weight         Float?                               // 體重 (kg)
  bodyFat        Float?   @map("body_fat")            // 體脂率 (%)
  oxygenSat      Float?   @map("oxygen_sat")          // 血氧 (%)

  note           String?

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("health_records")
}

model HealthSharePermission {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  viewerId  String   @map("viewer_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  owner  User @relation("healthOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer User @relation("healthViewer", fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, viewerId])
  @@map("health_share_permissions")
}


// ── Wiki 文件庫 ────────────────────────────────────────────

model WikiPage {
  id          String     @id @default(uuid()) @db.Uuid
  slug        String     @unique
  title       String
  content     String     @db.Text    // Markdown 原文
  category    String     @default("general")
  visibility  Visibility @default(FAMILY)
  authorId    String     @map("author_id") @db.Uuid
  pinned      Boolean    @default(false)

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  versions    WikiPageVersion[]
  permissions WikiPagePermission[]

  @@index([authorId])
  @@index([category])
  @@index([createdAt])
  @@map("wiki_pages")
}

model WikiPageVersion {
  id         String   @id @default(uuid()) @db.Uuid
  pageId     String   @map("page_id") @db.Uuid
  title      String
  content    String   @db.Text
  editedById String   @map("edited_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  page     WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editedBy User     @relation(fields: [editedById], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@map("wiki_page_versions")
}

model WikiPagePermission {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @map("page_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@map("wiki_page_permissions")
}


// ── 通訊錄 ──────────────────────────────────────────────────

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid        // 建立者
  name       String                                      // 姓名
  phone      String?                                     // 電話（主要）
  phone2     String?   @map("phone_2")                  // 電話（次要）
  email      String?                                     // Email
  company    String?                                     // 公司 / 單位
  jobTitle   String?   @map("job_title")                // 職稱
  address    String?                                     // 地址
  birthday   DateTime? @db.Date                          // 生日
  note       String?                                     // 備註
  group      String    @default("other")                 // 群組分類
  isShared   Boolean   @default(false) @map("is_shared") // 是否分享至共同通訊錄
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isShared])
  @@index([name])
  @@map("contacts")
}

// ── 記事本 ──────────────────────────────────────────────────

enum NoteVisibility {
  PRIVATE    // 僅自己
  FAMILY     // 全家人
  SELECTED   // 指定家人
}

model Note {
  id          String         @id @default(uuid()) @db.Uuid
  authorId    String         @map("author_id") @db.Uuid
  title       String
  content     String         @default("")        // Markdown 內容
  color       String?                             // 背景色 hex
  pinned      Boolean        @default(false)
  visibility  NoteVisibility @default(PRIVATE)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  author      User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  audiences   NoteAudience[]
  tags        NoteTag[]

  @@index([authorId])
  @@map("notes")
}

model NoteAudience {
  noteId    String  @map("note_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid

  note      Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
  @@map("note_audiences")
}

model NoteTag {
  id        String  @id @default(uuid()) @db.Uuid
  noteId    String  @map("note_id") @db.Uuid
  name      String

  note      Note    @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
  @@map("note_tags")
}

// ══════════════════════════════════════════════════════════════
// ── 用車管理模組 ─────────────────────────────────────────────
// ══════════════════════════════════════════════════════════════

// ── Model 1：Vehicle（車輛資訊）────────────────────────────

model Vehicle {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String                                    // 車輛名稱（如「CX-30」）
  brand                 String                                    // 品牌（Mazda）
  model                 String                                    // 車型（CX-30）
  plateNumber           String    @map("plate_number")            // 車牌號碼
  purchaseDate          DateTime? @map("purchase_date") @db.Date  // 購入日期
  warrantyEnd           DateTime? @map("warranty_end") @db.Date   // 保固到期日
  insuranceEnd          DateTime? @map("insurance_end") @db.Date  // 保險到期日
  nextMaintenanceDate   DateTime? @map("next_maintenance_date") @db.Date  // 下次保養日期
  nextMaintenanceMileage Int?     @map("next_maintenance_mileage")        // 下次保養里程
  currentMileage        Int?      @map("current_mileage")                 // 目前里程數
  color                 String?                                    // 車色
  vin                   String?                                    // 車身號碼
  note                  String?                                    // 備註
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")

  bookings              CarBooking[]
  costRecords           CarCostRecord[]
  costConfigs           CarCostConfig[]
  loans                 CarLoan[]
  fuelRecords           CarFuelRecord[]
  mileageLogs           CarMileageLog[]

  @@map("vehicles")
}

// ── Model 2：CarBooking（用車預約）────────────────────────

model CarBooking {
  id                String         @id @default(uuid()) @db.Uuid
  vehicleId         String         @map("vehicle_id") @db.Uuid
  userId            String         @map("user_id") @db.Uuid
  startDate         DateTime       @map("start_date") @db.Date
  endDate           DateTime       @map("end_date") @db.Date
  applyDays         Int            @map("apply_days")              // 申請天數
  purpose           String                                          // 用途
  status            BookingStatus  @default(RESERVED)
  countedDays       Int            @default(0) @map("counted_days") // 計入天數
  startMileage      Int?           @map("start_mileage")           // 出車里程
  endMileage        Int?           @map("end_mileage")             // 還車里程
  tripDistance      Int?           @map("trip_distance")           // 本次行駛公里數
  isRecurring       Boolean        @default(false) @map("is_recurring")
  recurringType     RecurringType? @map("recurring_type")
  recurringEndDate  DateTime?      @map("recurring_end_date") @db.Date
  parentBookingId   String?        @map("parent_booking_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at")

  vehicle           Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentBooking     CarBooking?    @relation("recurringBookings", fields: [parentBookingId], references: [id], onDelete: SetNull)
  childBookings     CarBooking[]   @relation("recurringBookings")

  @@index([vehicleId])
  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@index([parentBookingId])
  @@map("car_bookings")
}

// ── Model 3：CarCostRecord（費用結算）─────────────────────

model CarCostRecord {
  id              String         @id @default(uuid()) @db.Uuid
  vehicleId       String         @map("vehicle_id") @db.Uuid
  settlementDate  DateTime       @map("settlement_date") @db.Date  // 結算日期
  item            String                                            // 費用項目名稱
  totalAmount     Decimal        @map("total_amount") @db.Decimal(12, 2)
  parentAmount    Decimal        @map("parent_amount") @db.Decimal(12, 2)
  paidById        String         @map("paid_by_id") @db.Uuid       // 實際繳費人
  paymentMethod   PaymentMethod  @map("payment_method")
  paymentRef      String?        @map("payment_ref")               // 繳費參考
  paymentNote     String?        @map("payment_note")              // 繳費備註
  configId        String?        @map("config_id") @db.Uuid        // 套用的規則版本
  periodStart     DateTime?      @map("period_start") @db.Date     // 統計期間起
  periodEnd       DateTime?      @map("period_end") @db.Date       // 統計期間迄
  auditCheck      Boolean        @default(false) @map("audit_check")
  status          CostStatus     @default(PENDING)
  createdBy       String         @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")

  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  paidBy          User           @relation("costPaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  creator         User           @relation("costCreatedBy", fields: [createdBy], references: [id], onDelete: Cascade)
  config          CarCostConfig? @relation(fields: [configId], references: [id], onDelete: SetNull)
  shares          CarCostShare[]
  attachments     CarCostAttachment[]
  amendments      CarCostAmendment[]

  @@index([vehicleId])
  @@index([settlementDate])
  @@index([item])
  @@index([paidById])
  @@index([createdBy])
  @@map("car_cost_records")
}

// ── Model 4：CarCostShare（每人分攤明細）──────────────────

model CarCostShare {
  id              String         @id @default(uuid()) @db.Uuid
  costRecordId    String         @map("cost_record_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  usageDays       Int            @map("usage_days")               // 使用天數
  amount          Decimal        @db.Decimal(12, 2)                // 分攤金額
  paymentStatus   PaymentStatus  @default(UNPAID) @map("payment_status")
  paidAt          DateTime?      @map("paid_at")
  confirmedBy     String?        @map("confirmed_by") @db.Uuid
  confirmedAt     DateTime?      @map("confirmed_at")

  costRecord      CarCostRecord  @relation(fields: [costRecordId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmer       User?          @relation("shareConfirmedBy", fields: [confirmedBy], references: [id], onDelete: SetNull)

  @@index([costRecordId])
  @@index([userId])
  @@index([paymentStatus])
  @@map("car_cost_shares")
}

// ── Model 5：CarCostAttachment（費用附件）─────────────────

model CarCostAttachment {
  id              String         @id @default(uuid()) @db.Uuid
  costRecordId    String         @map("cost_record_id") @db.Uuid
  uploaderId      String         @map("uploader_id") @db.Uuid
  filename        String                                           // 原始檔名
  storagePath     String         @map("storage_path")              // gdrive:<fileId>
  mimeType        String         @map("mime_type")
  fileSize        Int            @map("file_size")                 // bytes
  docType         DocType        @default(OTHER) @map("doc_type")
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at")

  costRecord      CarCostRecord  @relation(fields: [costRecordId], references: [id], onDelete: Cascade)
  uploader        User           @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([costRecordId])
  @@map("car_cost_attachments")
}

// ── Model 6：CarCostConfig（費用分攤規則）─────────────────

model CarCostConfig {
  id                  String         @id @default(uuid()) @db.Uuid
  vehicleId           String         @map("vehicle_id") @db.Uuid
  item                String                                       // 費用項目名稱
  parentRatio         Decimal        @map("parent_ratio") @db.Decimal(5, 4)  // 0~1
  calcMethod          CalcMethod     @map("calc_method")
  dualTrackBaseRatio  Decimal        @default(0.5) @map("dual_track_base_ratio") @db.Decimal(5, 4)
  effectiveFrom       DateTime       @map("effective_from") @db.Date
  effectiveMode       EffectiveMode  @map("effective_mode")
  isActive            Boolean        @default(true) @map("is_active")
  note                String?
  createdBy           String         @map("created_by") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")

  vehicle             Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  creator             User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  costRecords         CarCostRecord[]

  @@index([vehicleId, item])
  @@index([effectiveFrom])
  @@map("car_cost_configs")
}

// ── Model 7：CarLoan（貸款資訊）──────────────────────────

model CarLoan {
  id                String    @id @default(uuid()) @db.Uuid
  vehicleId         String?   @map("vehicle_id") @db.Uuid          // 車貸時關聯車輛（選填）
  loanType          String    @default("CAR_LOAN") @map("loan_type") // 貸款類型
  loanName          String?   @map("loan_name")                     // 自訂名稱（如：機車貸款）
  lender            String                                        // 貸款機構
  totalAmount       Decimal   @map("total_amount") @db.Decimal(12, 2)   // 總價
  downPayment       Decimal   @map("down_payment") @db.Decimal(12, 2)  // 頭期款
  loanAmount        Decimal   @map("loan_amount") @db.Decimal(12, 2)   // 實際貸款金額
  interestRate      Decimal   @map("interest_rate") @db.Decimal(6, 4)  // 年利率 %
  totalInstallments Int       @map("total_installments")                // 總期數
  monthlyPayment    Decimal   @map("monthly_payment") @db.Decimal(12, 2)
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime  @map("end_date") @db.Date
  paymentDay        Int       @map("payment_day")                      // 每月扣款日（1-31）
  note              String?
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")

  vehicle           Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  payments          CarLoanPayment[]

  @@index([vehicleId])
  @@index([loanType])
  @@map("car_loans")
}

// ── Model 8：CarLoanPayment（車貸還款記錄）────────────────

model CarLoanPayment {
  id                String             @id @default(uuid()) @db.Uuid
  loanId            String             @map("loan_id") @db.Uuid
  installmentNo     Int                @map("installment_no")          // 第幾期
  dueDate           DateTime           @map("due_date") @db.Date      // 應繳日期
  amount            Decimal            @db.Decimal(12, 2)              // 應繳金額
  principal         Decimal            @db.Decimal(12, 2)              // 本金
  interest          Decimal            @db.Decimal(12, 2)              // 利息
  remainingBalance  Decimal            @map("remaining_balance") @db.Decimal(12, 2)
  status            LoanPaymentStatus  @default(UPCOMING)
  paidAt            DateTime?          @map("paid_at")
  note              String?

  loan              CarLoan            @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId])
  @@index([dueDate])
  @@index([status])
  @@map("car_loan_payments")
}

// ── Model 9：CarFuelRecord（加油/充電記錄）────────────────

model CarFuelRecord {
  id              String         @id @default(uuid()) @db.Uuid
  vehicleId       String         @map("vehicle_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid          // 加油人
  fuelDate        DateTime       @map("fuel_date") @db.Date
  fuelType        FuelType       @map("fuel_type")
  amount          Decimal        @db.Decimal(12, 2)                 // 金額
  liters          Decimal?       @db.Decimal(8, 2)                  // 公升數
  kwh             Decimal?       @db.Decimal(8, 2)                  // 度數
  pricePerUnit    Decimal?       @map("price_per_unit") @db.Decimal(8, 2)
  mileage         Int                                               // 加油時里程
  station         String?                                           // 加油站名稱
  paymentMethod   PaymentMethod  @map("payment_method")
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at")

  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([userId])
  @@index([fuelDate])
  @@map("car_fuel_records")
}

// ── Model 10：CarCostAmendment（費用修正記錄）─────────────

model CarCostAmendment {
  id              String         @id @default(uuid()) @db.Uuid
  costRecordId    String         @map("cost_record_id") @db.Uuid
  amendedBy       String         @map("amended_by") @db.Uuid
  reason          String                                           // 修正原因
  fieldChanged    String         @map("field_changed")             // 修改的欄位
  oldValue        String         @map("old_value")
  newValue        String         @map("new_value")
  createdAt       DateTime       @default(now()) @map("created_at")

  costRecord      CarCostRecord  @relation(fields: [costRecordId], references: [id], onDelete: Cascade)
  amendedByUser   User           @relation(fields: [amendedBy], references: [id], onDelete: Cascade)

  @@index([costRecordId])
  @@map("car_cost_amendments")
}

// ── Model 11：CarNotification（用車通知）──────────────────

model CarNotification {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  type            CarNotificationType
  title           String
  message         String
  relatedId       String?              @map("related_id") @db.Uuid
  isRead          Boolean              @default(false) @map("is_read")
  createdAt       DateTime             @default(now()) @map("created_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("car_notifications")
}

// ── Model 12：CarMileageLog（里程記錄）────────────────────

model CarMileageLog {
  id              String         @id @default(uuid()) @db.Uuid
  vehicleId       String         @map("vehicle_id") @db.Uuid
  userId          String         @map("user_id") @db.Uuid
  mileage         Int                                              // 里程數
  source          MileageSource                                    // 記錄來源
  note            String?
  recordedAt      DateTime       @map("recorded_at") @default(now())

  vehicle         Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([vehicleId, recordedAt])
  @@index([userId])
  @@map("car_mileage_logs")
}

// ── 快捷分享 ──────────────────────────────────────────────────

enum QuickShareType {
  LINK
  LOCATION
  MEMO
}

enum QuickShareVisibility {
  PRIVATE
  FAMILY
}

model ShareCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique                                // 分類名稱（唯一）
  emoji     String   @default("📎")                         // 分類圖示 emoji
  sortOrder Int      @default(0) @map("sort_order")         // 排序（小在前）
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  creator   User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  shares    QuickShare[]

  @@index([sortOrder])
  @@map("share_categories")
}

model QuickShare {
  id              String               @id @default(uuid()) @db.Uuid
  authorId        String               @map("author_id") @db.Uuid
  type            QuickShareType                                      // 主要類型 LINK / LOCATION / MEMO
  content         String                                               // 主要內容（URL / 地址 / 備忘）
  title           String?                                              // 網址標題 / 位置名稱 / null
  description     String?                                              // OG 描述 / 完整地址 / null
  imageUrl        String?              @map("image_url")               // OG 圖片 / null
  mapUrl          String?              @map("map_url")                 // Google Maps URL
  memo            String?                                              // 附加備忘文字（所有類型可用）
  linkUrl         String?              @map("link_url")                // 附加網址（LOCATION/MEMO 也可夾帶連結）
  linkTitle       String?              @map("link_title")              // 附加網址的 OG 標題
  linkImage       String?              @map("link_image")              // 附加網址的 OG 圖片
  locationAddress String?              @map("location_address")        // 附加地址（LINK/MEMO 也可夾帶位置）
  locationName    String?              @map("location_name")           // 附加地址名稱
  locationMapUrl  String?              @map("location_map_url")        // 附加地址的 Maps URL
  pinned          Boolean              @default(false)
  visibility      QuickShareVisibility @default(FAMILY)
  categoryId      String?              @map("category_id") @db.Uuid   // 分類（選填）
  updatedAt       DateTime?            @updatedAt @map("updated_at")   // 編輯時間
  createdAt       DateTime             @default(now()) @map("created_at")

  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryRef ShareCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([createdAt])
  @@index([categoryId])
  @@map("quick_shares")
}


// ── 看板管理 (Kanban) ────────────────────────────────────────

enum KanbanVisibility {
  PRIVATE   // 個人看板
  FAMILY    // 家庭共用看板
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model KanbanBoard {
  id          String           @id @default(uuid()) @db.Uuid
  title       String                                              // 看板標題
  emoji       String           @default("📋")                     // 看板圖示
  description String?                                             // 看板描述
  visibility  KanbanVisibility @default(FAMILY)
  archived    Boolean          @default(false)                    // 是否封存
  creatorId   String           @map("creator_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  creator     User             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  columns     KanbanColumn[]

  @@index([creatorId])
  @@index([visibility])
  @@map("kanban_boards")
}

model KanbanColumn {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  title     String                                                // 欄位標題
  color     String   @default("#5a7a5a")                          // 欄位顏色
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  board     KanbanBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     KanbanCard[]

  @@index([boardId])
  @@index([sortOrder])
  @@map("kanban_columns")
}

model KanbanCard {
  id          String        @id @default(uuid()) @db.Uuid
  columnId    String        @map("column_id") @db.Uuid
  title       String                                              // 卡片標題
  description String?                                             // 卡片描述
  priority    CardPriority? // 優先順序
  label       String?                                             // 標籤顏色 hex
  dueDate     DateTime?     @map("due_date")                      // 到期日
  assigneeId  String?       @map("assignee_id") @db.Uuid         // 指派成員
  sortOrder   Int           @default(0) @map("sort_order")
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  column      KanbanColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee    User?         @relation("kanbanAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User          @relation("kanbanCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  checklists  KanbanChecklist[]

  @@index([columnId])
  @@index([assigneeId])
  @@index([sortOrder])
  @@map("kanban_cards")
}

model KanbanChecklist {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @map("card_id") @db.Uuid
  text      String
  checked   Boolean  @default(false)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  card      KanbanCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("kanban_checklists")
}


// ── 個人記帳 ──────────────────────────────────────────────

enum ExpenseType {
  INCOME
  EXPENSE
}

model ExpenseCategory {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  name      String
  emoji     String      @default("📦")
  type      ExpenseType @default(EXPENSE)
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  records ExpenseRecord[]

  @@index([userId])
  @@map("expense_categories")
}

model ExpenseRecord {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  categoryId String?     @map("category_id") @db.Uuid
  amount     Int                                          // NT$ 整數
  type       ExpenseType @default(EXPENSE)
  date       DateTime    @db.Date
  note       String?
  visibility String      @default("PRIVATE")               // PRIVATE or FAMILY
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([categoryId])
  @@map("expense_records")
}

model ExpenseBudget {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  month  String                                   // "2026-11" 格式
  amount Int                                      // NT$ 整數

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("expense_budgets")
}
