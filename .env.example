# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://shiri:CHANGE_ME@localhost:5432/shiri?schema=public

# ── App ───────────────────────────────────────────────────
APP_ORIGIN=https://fb.kiseki.me
APP_TIMEZONE=Asia/Taipei

# ── Session ───────────────────────────────────────────────
SESSION_IDLE_SECONDS=86400
SESSION_MAX_SECONDS=604800

# ── Temporary password ────────────────────────────────────
TEMP_PASSWORD_TTL_SECONDS=86400

# ── Media storage ─────────────────────────────────────────
MEDIA_ROOT=/data/media
UPLOAD_TMP_ROOT=/data/uploads
